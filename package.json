{
  "name": "websevice-mvc-express-nodejs",
  "version": "1.0.0",
  "description": "structure api mvc express nodejs",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build:ts": "tsc",
    "start": "node src/app.js",
    "dev": "nodemon --watch src --ext js,ts --exec \"npm run build:ts && node src/app.js\"",
    "drizzle:generate": "npm run build:ts && drizzle-kit generate:pg",
    "drizzle:migrate": "npm run build:ts && drizzle-kit migrate:pg",
    "drizzle:studio": "drizzle-kit studio",
    "dev:js": "nodemon index.js",
    "lint-cc": "eslint --cache",
    "check-style": "prettier --check src"
  },
  "_moduleAliases": {
    "@": "src"
  },
  "keywords": [
    "express",
    "backend"
  ],
  "author": "nghiango <nghiangots@gmail.com>",
  "license": "ISC",
  "dependencies": {
    "accesscontrol": "^2.2.1",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "dotenv": "^16.0.1",
    "drizzle-orm": "^0.43.1",
    "express": "^4.18.1",
    "helmet": "^5.1.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.2.3",
    "mongoose": "^6.3.3",
    "morgan": "^1.10.0",
    "node-fetch": "^3.3.2",
    "nodemon": "^3.1.10",
    "redis": "^3.1.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.7.2",
    "winston-daily-rotate-file": "^5.0.0",
    "xxx": "./libs/xxx"
  },
  "devDependencies": {
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.5.0"
  }
}
